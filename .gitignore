# 依赖与构建产物
node_modules/
dist/
.vite/
# 本机原生工具链（wasm-opt 等），脚本会回退到 npm 的 binaryen 包
tools/
# wasm-opt 的候选产物：实测收益为负，不接运行时路径，也别让它进仓库
public/wasm/8.0.1/clang_opt.wasm
# 题解渲染器（katex + marked 的副本）：由 scripts/prepare-md-runtime.mjs 从 node_modules 生成，
# 是构建输入而不是源码，跟着 katex 版本走，不进仓库（见 npm run md:runtime）
public/md/

# 环境变量（后端地址 / API Key 一律不进仓库）
.env
.env.*
!.env.example

# Vercel 本地 CLI 状态
.vercel/

# 本地调试与回归产物
cp-*.png
screenshots/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本机 CPH 插件的工作区产物（仓库根被当成 CPH 工作区时生成）
.cph/
/*.cpp

# 协作工具的工作目录（交接笔记 / 每日日志），是本地资料不是站点内容，别跟着产物一起发出去
.workbuddy/

# 编辑器与系统
.DS_Store
.idea/
.vscode/
.trae/

# Vite 的 *.local 约定（含 .env.local 之类）
*.local