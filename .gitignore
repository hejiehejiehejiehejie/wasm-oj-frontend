# 依赖与构建产物
node_modules/
dist/
.vite/
# 本机原生工具链（wasm-opt 等），脚本会回退到 npm 的 binaryen 包
tools/
# wasm-opt 的候选产物：实测收益为负，不接运行时路径，也别让它进仓库
public/wasm/8.0.1/clang_opt.wasm

# 环境变量（后端地址 / API Key 一律不进仓库）
.env
.env.*
!.env.example

# Vercel 本地 CLI 状态
.vercel/

# 本地调试与回归产物
cph-*.png
screenshots/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器与系统
.DS_Store
.idea/
.vscode/
.trae/

# Vite 的 *.local 约定（含 .env.local 之类）
*.local