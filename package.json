{
  "name": "cp-ide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run md:runtime",
    "dev": "vite",
    "prebuild": "npm run notice && npm run md:runtime",
    "build": "vite build",
    "build:tauri": "npm run build && node scripts/strip-wasm-assets.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify": "node scripts/verify-ui.mjs",
    "screenshots:store": "node scripts/generate-store-screenshots.mjs",
    "notice": "node scripts/render-notice.mjs",
    "notice:check": "node scripts/render-notice.mjs --check",
    "wasm:opt": "node scripts/optimize-wasm.mjs",
    "md:runtime": "node scripts/prepare-md-runtime.mjs",
    "android:toolchain": "node scripts/prepare-android-toolchain.mjs"
  },
  "dependencies": {
    "@runno/wasi": "0.10.0",
    "@tauri-apps/api": "^2.12.1",
    "dompurify": "^3.4.8",
    "katex": "^0.18.9",
    "marked": "^14.0.0",
    "monaco-editor": "^0.56.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "binaryen": "^132.0.0",
    "postcss-pxtorem": "^6.1.0",
    "puppeteer-core": "^25.11.0",
    "vite": "^8.3.0"
  }
}
